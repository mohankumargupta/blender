---
import '../styles/blender.css';
import TopBar from '../components/blender/TopBar.astro';
import Toolbar from '../components/blender/Toolbar.astro';
import Outliner from '../components/blender/Outliner.astro';
import PropertiesPanel from '../components/blender/PropertiesPanel.astro';
import StatusBar from '../components/blender/StatusBar.astro';

const { frontmatter } = Astro.props;
const { title, scene, stats } = frontmatter || {};

const sidebarEntries = [
  { label: 'Layout', link: '/custom-ui/' },
  { label: 'UV', link: '/custom-ui/modelling/' },
  { label: 'Shader', link: '/custom-ui/shading/' },
  { label: 'Animation', link: '/custom-ui/animation/' },
  { label: 'Render', link: '/custom-ui/render/' },
];
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title ? `${title} - Blender UI` : 'Blender UI'}</title>
  </head>
  <body>
    <div id="app">
      <TopBar sidebarEntries={sidebarEntries} />
      <Toolbar />
      
      <div class="viewport" id="viewport">
        <!-- SECONDARY MENU (VIEWPORT HEADER) -->
        <div class="viewport-header">
          <span class="drag-handle" title="Split window">⌖</span>
          
          <select class="mode-select" id="modeSelect">
            <option>Object Mode</option>
            <option>Edit Mode</option>
            <option>Sculpt Mode</option>
          </select>

          <div class="vp-menu">
            <button>View</button>
            <button>Select</button>
            <button>Add</button>
            <button>Object</button>
          </div>

          <div class="vp-right">
            <button class="vp-icon-btn" title="Proportional Editing">◎</button>
            
            <div class="vp-divider"></div>
            
            <div class="shading-group">
              <button class="vp-icon-btn" title="Wireframe">⭘</button>
              <button class="vp-icon-btn active" title="Solid">⬤</button>
              <button class="vp-icon-btn" title="Material Preview">◑</button>
              <button class="vp-icon-btn" title="Rendered">🌑</button>
            </div>
          </div>
          
          <span class="drag-handle" title="Split window">⌖</span>
        </div>

        <div class="viewport-grid"></div>
        <div class="viewport-label">{          
          title === 'Layout' 
            ? 'Press Help Menu for other keyboard shortcuts' 
            : (title || 'User Perspective')
          }</div>
        <div class="viewport-hint">Drag to orbit<br>Scroll to zoom</div>
        
        <!-- MDX docs render here inside the viewport! -->
        <div class="viewport-content prose">
          <slot />
        </div>
      </div>

      <div class="sidebar">
        <Outliner tree={scene || []} />
        <PropertiesPanel />
      </div>

      <StatusBar stats={stats || {}} />
    </div>
    <script src="../scripts/blender-ui.ts"></script>
  </body>
</html>